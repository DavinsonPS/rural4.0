PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rural40_db
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_CONNECTION_LIMIT=10

# Obligatorio: firma las cookies de sesión. Sin esta variable la aplicación no arranca.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# Claves que usan los ESP32 (sensor y cámara) para registrarse. Van compiladas en el firmware.
DEVICE_PROVISIONING_KEY=cambia_esta_clave_de_aprovisionamiento
DEVICE_REGISTRATION_KEY=cambia_esta_clave_de_registro

# SMTP Moshipp
EMAIL_HOST=mail.rural40.ml-ware.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=notificaciones@rural40.ml-ware.com
EMAIL_PASS=tu_contrasena_del_correo
MAIL_FROM=Rural 4.0 <notificaciones@rural40.ml-ware.com>
APP_URL=http://localhost:3000
