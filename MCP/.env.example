# Exponer el MCP solo en loopback cuando se ejecuta en el mismo servidor que el backend.
# Desarrollo local: 127.0.0.1 y puerto 3000.
# Servidor detrás de proxy/reverse proxy: normalmente usar MCP_HOST=0.0.0.0.
MCP_HOST=127.0.0.1
# Si el hosting define PORT, se usa PORT antes que MCP_PORT.
MCP_PORT=3000
# Token compartido exclusivamente entre el backend de confianza y el MCP.
MCP_SERVICE_TOKEN=

# Si la base productiva solo es accesible por SSH, DB_HOST/DB_PORT deben apuntar
# al extremo local del túnel SSH ya establecido.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
